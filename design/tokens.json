{
  "$description": "DOGS design tokens v0.2 — primitive → semantic(light/dark) → component. Compose: semantic → ColorScheme + DogsColors, component → *Defaults.",
  "primitive": {
    "color": {
      "neutral": {
        "0": "#FFFFFF",
        "25": "#F5F6F3",
        "50": "#EDEFEB",
        "100": "#E2E5E0",
        "200": "#C3C9C5",
        "500": "#687270",
        "600": "#59645E",
        "900": "#17201C",
        "d900": "#121614",
        "d850": "#1B201D",
        "d800": "#232925",
        "d750": "#2C332F",
        "d400": "#7D8781",
        "d300": "#A9B3AD",
        "d100": "#E7ECE9"
      },
      "evergreen": {
        "50": "#E5EEE9",
        "300": "#A8DCC4",
        "400": "#7CC3A4",
        "700": "#24614B",
        "800": "#174535",
        "900": "#0E2A20",
        "d50": "#1F3A2F"
      },
      "amber": {
        "50": "#F6ECE0",
        "400": "#E3A060",
        "700": "#965210",
        "d50": "#3A2C1D"
      },
      "red": {
        "400": "#F08A78",
        "700": "#B93A28"
      },
      "dog": {
        "kong-bg": "#E9DCC9",
        "kong-fg": "#6B4E2A",
        "bori-bg": "#D9E2E8",
        "bori-fg": "#33495A"
      }
    },
    "font": {
      "family": "Pretendard (Figma 시안: Noto Sans KR)",
      "weight": {
        "regular": 400,
        "medium": 500,
        "semibold": 600,
        "bold": 700
      }
    },
    "space": {
      "1": 4,
      "2": 8,
      "3": 12,
      "4": 16,
      "5": 20,
      "6": 24,
      "7": 28,
      "9": 36,
      "12": 48
    },
    "radius": {
      "sm": 8,
      "md": 12,
      "lg": 20,
      "full": 999
    }
  },
  "semantic": {
    "light": {
      "bg": "neutral.25",
      "surface": "neutral.0",
      "surface-raised": "neutral.0",
      "text": "neutral.900",
      "text-secondary": "neutral.600",
      "text-tertiary": "neutral.500",
      "border": "neutral.100",
      "divider": "neutral.50",
      "control-outline": "neutral.200",
      "primary": "evergreen.700",
      "on-primary": "neutral.0",
      "done-container": "evergreen.50",
      "on-done-container": "evergreen.800",
      "attention": "amber.700",
      "attention-container": "amber.50",
      "error": "red.700",
      "inverse": "neutral.900",
      "on-inverse": "neutral.0"
    },
    "dark": {
      "bg": "neutral.d900",
      "surface": "neutral.d850",
      "surface-raised": "neutral.d800",
      "text": "neutral.d100",
      "text-secondary": "neutral.d300",
      "text-tertiary": "neutral.d400",
      "border": "neutral.d750",
      "divider": "neutral.d800",
      "control-outline": "neutral.d400",
      "primary": "evergreen.400",
      "on-primary": "evergreen.900",
      "done-container": "evergreen.d50",
      "on-done-container": "evergreen.300",
      "attention": "amber.400",
      "attention-container": "amber.d50",
      "error": "red.400",
      "inverse": "neutral.d100",
      "on-inverse": "neutral.d900"
    },
    "contrast-checked": {
      "text/bg": "15.4 · 15.3",
      "text-secondary/bg": "5.7 · 8.5",
      "text-tertiary/bg": "4.6 · 4.9",
      "on-primary/primary": "7.3 · 7.4",
      "attention/attention-container": "5.1 · —",
      "on-done/done-container": "9.2 · 8.0"
    }
  },
  "typography": {
    "display": {
      "size": 26,
      "line": 34,
      "weight": "bold",
      "tracking": -0.025,
      "m3": "headlineSmall"
    },
    "title-l": {
      "size": 20,
      "line": 28,
      "weight": "bold",
      "tracking": -0.02,
      "m3": "titleLarge"
    },
    "title-m": {
      "size": 18,
      "line": 26,
      "weight": "bold",
      "tracking": -0.015,
      "m3": "titleMedium"
    },
    "body-l": {
      "size": 16,
      "line": 24,
      "weight": "semibold",
      "tracking": -0.01,
      "m3": "bodyLarge"
    },
    "body-m": {
      "size": 14,
      "line": 22,
      "weight": "medium",
      "tracking": 0,
      "m3": "bodyMedium"
    },
    "label": {
      "size": 13,
      "line": 18,
      "weight": "medium",
      "tracking": 0,
      "m3": "labelMedium"
    },
    "caption": {
      "size": 12,
      "line": 16,
      "weight": "semibold",
      "tracking": 0,
      "m3": "labelSmall"
    }
  },
  "component": {
    "button-primary": {
      "height": 48,
      "radius": "full",
      "bg": "primary",
      "fg": "on-primary",
      "states": {
        "pressed": "state-layer on-primary 10%",
        "disabled": "bg text 12% · fg text 38%",
        "loading": "spinner 20dp, label hidden, width fixed"
      }
    },
    "button-inverse": {
      "height": 40,
      "radius": "full",
      "bg": "inverse",
      "fg": "on-inverse"
    },
    "button-outline": {
      "height": 40,
      "radius": "full",
      "bg": "transparent",
      "fg": "text",
      "border": "border"
    },
    "chip-dog": {
      "height": 40,
      "radius": "full",
      "avatar": 32,
      "states": {
        "selected": "bg inverse · fg on-inverse",
        "default": "bg surface · border border · fg text-secondary"
      }
    },
    "task-row": {
      "min-height": 68,
      "time-col": 44,
      "check-visual": 26,
      "check-touch": 48,
      "states": {
        "upcoming": "outline ring",
        "late": "attention text + attention ring",
        "done": "strike text-tertiary + done badge(name · time)",
        "pressed": "ring fills primary 200ms"
      }
    },
    "next-task-card": {
      "radius": "lg",
      "padding": 20,
      "bg": "surface",
      "border": "divider"
    },
    "request-card": {
      "radius": "lg",
      "padding": 18,
      "bg": "attention-container"
    },
    "day-rail": {
      "range": "06–24",
      "height": 64,
      "tick": 16,
      "states": [
        "done",
        "late",
        "upcoming",
        "now"
      ]
    },
    "nav-bar": {
      "height": 80,
      "indicator": "56x32 done-container",
      "items": 4
    },
    "text-field": {
      "height": 56,
      "radius": "md",
      "label": "label 13 above field, always visible",
      "bg": "surface",
      "border": "border",
      "states": {
        "focused": "border primary 2dp",
        "error": "border error 2dp + helper text error (role=alert)",
        "disabled": "bg divider, text text-tertiary"
      },
      "password": "trailing visibility toggle 48dp"
    },
    "fab-extended": {
      "height": 56,
      "radius": 16,
      "bg": "primary",
      "fg": "on-primary",
      "icon": 24,
      "position": "end 16 / above nav 16",
      "visibility": "leader only (할 일), all members (사진첩)"
    },
    "week-strip": {
      "cell": "44x64",
      "radius": "lg",
      "states": {
        "selected": "bg inverse, fg on-inverse",
        "today-unselected": "text primary",
        "default": "text text-secondary"
      },
      "indicator": "dot 4dp: all done primary, missed attention"
    },
    "proposal-banner": {
      "radius": "lg",
      "bg": "attention-container",
      "actions": [
        "승인 (button-inverse 40)",
        "거절 (button-outline 40)"
      ],
      "visibility": "leader only"
    },
    "photo-grid": {
      "columns": 3,
      "gap": 4,
      "padding": 20,
      "tile-radius": "sm",
      "aspect": "1:1",
      "loading": "bg divider placeholder, lazy"
    },
    "member-row": {
      "min-height": 64,
      "avatar": 40,
      "role-badge": "done-container / on-done-container, 24 height"
    },
    "invite-code": {
      "radius": "lg",
      "bg": "surface",
      "code": "title-l tabular, letter-spacing 2",
      "actions": [
        "코드 복사",
        "공유"
      ],
      "visibility": "leader only"
    },
    "top-bar-back": {
      "height": 64,
      "leading": "back 48dp",
      "title": "title-m center-start",
      "trailing": "text action or icon 48dp"
    },
    "bottom-action": {
      "height": "52 button + 16 padding + gesture inset",
      "bg": "bg",
      "divider": "top divider when content scrolls",
      "states": {
        "disabled": "until required fields valid"
      }
    },
    "segmented": {
      "height": 44,
      "radius": "full",
      "track": "divider",
      "selected": "surface + text, 1dp border"
    },
    "weekday-picker": {
      "cell": 40,
      "radius": "full",
      "selected": "inverse / on-inverse",
      "default": "surface + border"
    },
    "switch": {
      "track": "52x32",
      "on": "primary",
      "off": "outline track, surface thumb",
      "touch": 48
    },
    "settings-row": {
      "min-height": 56,
      "leading-icon": 24,
      "trailing": "value text / chevron / switch",
      "destructive": "error"
    },
    "dialog": {
      "width": 312,
      "radius": 28,
      "padding": 24,
      "scrim": "text 40%",
      "actions": "end aligned text/filled buttons 40"
    },
    "bottom-sheet": {
      "radius-top": 28,
      "handle": "32x4",
      "scrim": "text 40%"
    },
    "notification-row": {
      "min-height": 72,
      "unread": "primary dot 8 + text weight 600",
      "read": "text-secondary"
    },
    "chat-bubble": {
      "radius": 20,
      "user": "inverse / on-inverse end",
      "assistant": "surface + border start",
      "max-width": 264
    },
    "empty-state": {
      "illustration": "day-rail motif or icon 48",
      "title": "title-l",
      "body": "body-m text-secondary",
      "action": "button-primary"
    }
  }
}